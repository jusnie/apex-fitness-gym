{
  "name": "apex-workout",
  "version": "0.1.0",
  "description": "APEX Workout — premium local-first strength and nutrition tracker",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "npm run prepare:web && node server.js",
    "dev": "npm run prepare:web && node server.js",
    "test": "node --check script.js",
    "prepare:web": "node scripts/prepare-web.js",
    "android:sync": "npm run prepare:web && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "keywords": ["fitness", "strength", "workout", "local-first", "offline"],
  "author": "APEX Workout",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@phosphor-icons/web": "2.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9"
  }
}
